# Safe default. Replace with this server's LAN IP for access from another PC.
BIND_IP=127.0.0.1
PORT=5000
HOST_UID=1000
HOST_GID=1000

# Comma-separated exact HTTPS upstream origins.
ARGUS_ALLOWED_ORIGINS=https://upstream.example.internal

# Preferred: mount your internal CA and set its container path.
ARGUS_CA_BUNDLE=
# Fallback for trusted internal self-signed upstream only. Disables upstream TLS verification.
ARGUS_TLS_INSECURE=false
